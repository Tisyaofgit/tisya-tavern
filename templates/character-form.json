{
  "format": "tisya.form-authoring-template/1",
  "id": "character.dossier",
  "kind": "character",
  "targets": [
    {
      "tableId": "T_SYS_ENTITIES",
      "fields": [
        "kind",
        "origin_record_ref",
        "runtime_state_ref"
      ],
      "projections": [
        "entity_id",
        "name"
      ],
      "instruction": "人物名称和完整设定写入人物原点档案；程序建立主体及原点关联，不由模型重复建立人物注册。"
    },
    {
      "tableId": "T_CHAR_DOSSIER",
      "fields": [
        "name",
        "public_identity",
        "social_identity_duty",
        "overall_physique",
        "scene_personality_desc",
        "manifest"
      ],
      "instruction": "按当前完整字段逐项填写身份、外貌、性格、欲望、矛盾、面具、生活、表达、能力和边界；本领外显只写能力的实际表现。前史、关系与隐情分别使用关联子表。"
    },
    {
      "tableId": "T_DYN_CURRENCY_BALANCES",
      "fields": [
        "owner_ref",
        "currency_ref",
        "balance",
        "debt",
        "native_ref"
      ],
      "instruction": "只采用明确有据的初值；未知不填零，不把授信或贷款同时算作现金。"
    },
    {
      "tableId": "T_DYN_HOLDINGS_INVENTORY",
      "fields": [],
      "instruction": "关联已登记物品、所有者、保管者和数量，不因商品存在就授予持有。"
    }
  ]
}
