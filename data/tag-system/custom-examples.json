    {
      "manifest": {
        "package": "custom.court_tension",
        "name": "朝堂高张力试探私设包",
        "version": "2.0.0",
        "schema_version": 2,
        "author": "user",
        "description": "零新建坐标组、完全复用内置四极，为古风权谋强强关系提供茶席暗锋与宽袖掩触私设。",
        "depends": [
          "builtin>=2.0.0"
        ],
        "namespace": "custom.court"
      },
      "poles": [],
      "axes": [],
      "corpora": [
        {
          "id": "corpus.custom.court_etiquette_shield",
          "label": "朝堂礼制遮掩语料",
          "domain": "custom",
          "brief": "众目睽睽下越是衣冠肃穆、言辞恭谦，宽袖之下擦过的微凉指尖与茶盏轻磕就越令人心跳失序。",
          "full": {
            "world_rules": [
              "大庭广众下不得直呼私名或流露逾矩神色，所有威逼与偏爱都披着公事礼数外衣。",
              "敬茶、递帖、执礼的先后次序直接映射朝堂暗涌的权力位阶。"
            ],
            "observable_signals": [
              "盏盖轻磕青瓷声",
              "垂落宽袖遮住的桌下勾指",
              "官称与私名的一字之差"
            ],
            "consequences": [
              "一旦被政敌窥破半分破绽，私情就会立刻化作满朝风雨。"
            ]
          }
        }
      ],
      "techniques": [
        {
          "id": "tech.custom.court_veiled_edge",
          "label": "礼制藏锋",
          "slot": "dynamic.pacing",
          "purpose": "在滴水不漏的古风礼节外壳下，写出刀光剑影的筹码博弈或暗涌情愫。",
          "steps": {
            "observe": "先点明满座宾客、帘后视线或朝堂礼数，确立“绝不可当众失态”的舞台压迫。",
            "select": "挑选茶盏、折扇、奏折或宽袖中的一件器物作交锋媒介。",
            "express": "台词字字温雅合规，真实试探或越界藏进递物力度、半拍停顿与称呼微变。",
            "follow": "落笔对方在众人面前维持云淡风轻、唯有指尖轻颤或眼底暗涌的回敬。"
          },
          "variants": {
            "brief": "先立满座礼制约束，台词严守客套，把试探或暗触藏进器物递取、停顿与称呼微变中。",
            "full": "先交代旁观视线与礼仪红线确立压迫舞台；借茶盏、折扇或宽袖作掩护，让台词保持温雅恭谦，把筹码施压或私密勾指藏在停顿与称呼一字之差里，紧接描写对方表面镇定下的指尖回敬。"
          }
        }
      ],
