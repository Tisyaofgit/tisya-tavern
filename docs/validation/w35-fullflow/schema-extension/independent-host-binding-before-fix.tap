              include:
                op: 'selected'
            属性:
              type: 'object'
              capture: 'identity'
              include:
                op: 'selected'
          assemble:
            op: 'any'
            args:
              0:
                op: 'context'
              1:
                op: 'cue'
              2:
                op: 'tagged'
              3:
                op: 'retrieved'
              4:
                op: 'rule'
        1:
          id: 'facts'
          name: '事实与发现'
          aliases:
          version: 2
          owner: 'archive'
          fields:
            名称:
              type: 'text'
              required: true
              capture: 'evidence'
              include:
                op: 'selected'
            命题:
              type: 'text'
              capture: 'evidence'
              include:
                op: 'selected'
            条件:
              type: 'text'
              capture: 'evidence'
              include:
                op: 'selected'
            生效时间:
              type: 'text'
              capture: 'evidence'
              include:
                op: 'selected'
            验证状态:
              type: 'text'
              capture: 'evidence'
              include:
                op: 'selected'
            对象:
              type: 'refs'
              capture: 'reference'
              include:
                op: 'selected'
              follow: 'record'
            替代事实:
              type: 'refs'
              capture: 'reference'
              include:
                op: 'selected'
              follow: 'record'
            证据:
              type: 'texts'
              capture: 'evidence'
              include:
                op: 'selected'
            前史:
              type: 'object'
              fields:
                主体:
                  type: 'ref'
                  description: '所属对象的稳定ID。'
                时期:
                  type: 'text'
                  description: '明确早于当前开局的世界时期。'
                地点:
                  type: 'refs'
                  description: '已确认地点，不用文字邻接推导包含关系。'
                参与者:
                  type: 'refs'
                  description: '实际参与者不等于全体知情者。'
                选择:
                  type: 'text'
                  description: '材料明确的主动抉择；不能从获赠、持有或结果倒推自愿选择。'
                后果:
                  type: 'text'
                  description: '材料明确的事件结果；不把相邻叙述补成先后或因果。'
                当下影响:
                  type: 'text'
                  description: '明确由此事造成且仍持续的影响；不把别处已知事实当作此事后果。'
                原文:
                  type: 'text'
                  description: '已确认前史的原文；讨论示例不得升为事实。'
                涉及对象:
                  type: 'refs'
                  description: '本条明确涉及的其他已登记物品、组织或规则等；参与者与地点已有专格，不重复填；关联不代表参与或知情。'
                当时理解:
                  type: 'text'
                  description: '所属人物在此事当时怎样理解、相信或误解，限资料明确给出的心理或话语；不是客观定论或他人也知道，不用后来的认识倒灌。不明留空，受保护隐情仍归独立隐情。'
            关系底稿:
              type: 'object'
              fields:
                主体:
                  type: 'ref'
                  description: '关系方向的主体。'
                对象:
                  type: 'ref'
                  description: '持续联系另一端的稳定ID，可为人物、组织、地点或物品等；仅被提到不构成关系，同名不合并。'
                性质:
                  type: 'text'
                  description: '已确立的联系性质，如师徒、协作、长期责任或归属；责任和协作不自动成为私交。'
                形成经过:
                  type: 'text'
                  description: '该联系形成的已确认经过；不将仅同场或单次提及写成长期联系。'
                相处方式:
                  type: 'text'
                  description: '主体与本条对象的惯常互动或分工；不混入其他关系，不推断双向对称。'
                主体边界:
                  type: 'text'
                  description: '主体自己的边界与理由。'
                成立条件:
                  type: 'text'
                  description: '哪些前提使该关系成立；换U不能只改ID照搬。'
            隐情:
              type: 'object'
              fields:
                关联对象:
                  type: 'refs'
                  description: '秘密涉及的对象。'
                可观察线索:
                  type: 'texts'
                  description: '有依据的线索，不自动授予事实全貌。'
                揭示条件:
                  type: 'text'
                  description: '允许揭示的条件或永不揭示的约束，不等于已经公开。'
                影响范围:
                  type: 'text'
                  description: '秘密的影响，不作为人物已知信息。'
            世界设定:
              type: 'object'
              fields:
                领域:
                  type: 'enum'
                  values:
                    0: '方向'
                    1: '法则'
                    2: '空间'
                    3: '生态'
                    4: '社会'
                    5: '生活'
                    6: '文化'
                    7: '时间'
                相关对象:
                  type: 'refs'
                  description: '关联的真实实体/规则ID。'
                适用范围:
                  type: 'text'
                  description: '设定适用的世界、时代和范围。'
          assemble:
            op: 'always'
